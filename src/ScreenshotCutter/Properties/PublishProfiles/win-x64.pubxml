<?xml version="1.0" encoding="utf-8"?>
<!--
  配布用の発行設定（確定仕様書 2章）。

  Visual Studio では [発行] からこのプロファイルを選択できる。
  コマンドラインからは次のとおり:

      dotnet publish src/ScreenshotCutter/ScreenshotCutter.csproj -p:PublishProfile=win-x64

  WPF は PublishTrimmed に対応していないため、サイズ削減は行わない。
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>..\..\publish\win-x64\</PublishDir>

    <!-- ランタイム同梱。コピーするだけで動作させるため -->
    <SelfContained>true</SelfContained>

    <!-- 起動を速くする。サイズは増えるが割り切る -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- WPF は非対応 -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- exe + DLL 群 + settings.json の構成を維持する -->
    <PublishSingleFile>false</PublishSingleFile>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
