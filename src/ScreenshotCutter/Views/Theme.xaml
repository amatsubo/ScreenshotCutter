<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ライト基調の固定配色（確定仕様書 4.3.1）。
        テーマ追従はしないため、色はここに集約して直接指定する。
    -->

    <Color x:Key="AccentColor">#FF1B6FD8</Color>
    <Color x:Key="AccentHoverColor">#FF2E82EA</Color>
    <Color x:Key="AccentPressedColor">#FF14589F</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BorderBrushLight" Color="#FFD6D6D6" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF6A6A6A" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9D5D00" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFDFDFD" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFEDEDED" />

    <!-- 既定のフォントと文字色をすべてのウィンドウに適用する -->
    <Style x:Key="BaseControlStyle" TargetType="{x:Type Control}">
        <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo UI, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo UI, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo UI, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="{x:Type Label}" BasedOn="{StaticResource BaseControlStyle}" />
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseControlStyle}" />
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseControlStyle}" />
    <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource BaseControlStyle}" />
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseControlStyle}" />
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseControlStyle}" />

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseControlStyle}">
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}" />
    </Style>

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseControlStyle}">
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <!-- セクション見出し -->
    <Style x:Key="SectionHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- 補足説明・注釈 -->
    <Style x:Key="HintTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- エラー表示（ホットキー登録失敗など） -->
    <Style x:Key="ErrorTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WarningTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
