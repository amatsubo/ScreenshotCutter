<Window x:Class="ScreenshotCutter.Views.MonitorIdentifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="モニターの識別"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        SizeToContent="Manual">

    <!-- 各モニターの中央に番号を大きく表示する（確定仕様書 4.11.6） -->
    <Border Background="#E6101010"
            CornerRadius="18"
            BorderBrush="#FF3C7DD9"
            BorderThickness="2">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <TextBlock x:Name="NumberText"
                       Text="1"
                       Foreground="White"
                       FontSize="140"
                       FontWeight="Light"
                       LineHeight="150"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="NameText"
                       Text=""
                       Foreground="#FFD0D0D0"
                       FontSize="16"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />
            <TextBlock x:Name="ResolutionText"
                       Text=""
                       Foreground="#FF8A8A8A"
                       FontSize="13"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0" />
        </StackPanel>
    </Border>
</Window>
