# 既定はテキストとして扱い、チェックアウト時に環境の改行へ正規化する
* text=auto

# Windows 前提のファイルは CRLF を維持する
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.sln   text eol=crlf

*.cs      text diff=csharp
*.csproj  text
*.slnx    text
*.xaml    text
*.md      text
*.json    text
*.manifest text
*.pubxml  text

# バイナリ
*.ico   binary
*.png   binary
*.jpg   binary
*.wav   binary
